# Aconic — local development (copy values into backend/.env)

# Host port 5433 avoids clashing with a local Homebrew Postgres on 5432
DATABASE_URL=postgresql+psycopg2://aconic:aconic@localhost:5433/aconic

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — change in production
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini (key must allow embedContent + generateContent)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# App
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
UPLOAD_DIR=uploads
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAG_TOP_K=12
FULL_DOC_CHAR_LIMIT=60000
MAP_REDUCE_BATCH_SIZE=8
